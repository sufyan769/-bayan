{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/hadith/(?<id>[^/]+)", "destination": "/details/hadith?id=:id" },
    { "source": "/scholar/(?<id>[^/]+)", "destination": "/details/scholar?id=:id" },
    { "source": "/fatwa/(?<id>[^/]+)", "destination": "/details/fatwa?id=:id" },
    { "source": "/history/(?<id>[^/]+)", "destination": "/details/history?id=:id" },
    { "source": "/jarh/(?<id>[^/]+)", "destination": "/details/jarh?id=:id" }
  ]
}
